#include <stdio.h>

int main()
{
    int marks;

    printf("Enter marks: ");
    scanf("%d", &marks);

    if(marks >= 75)
        printf("Distinction");
    else if(marks >= 60)
        printf("First Class");
    else if(marks >= 35)
        printf("Pass");
    else
        printf("Fail");

    return 0;
}
